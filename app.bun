// app.bun — the router.
//
// Six pages, six endpoints, one file of routing. The server underneath is
// src/http.bun: raw sockets, keep-alive, chunked responses, no framework.

import { http_listen, http_serve_forever, http_html, http_json, http_text } from "./src/http.bun"
import { state, commit, reset, esc, new_id, clip } from "./src/store.bun"
import { seed } from "./src/seed.bun"
import { dot_by_id, page_by_id, space_by_id, run_by_id, thread_by_id, decide, send_message } from "./src/agent.bun"
import { view_today, view_dot, view_spaces, view_space, view_page, view_search, view_about } from "./src/views.bun"
import { view_tasks, view_memories, view_settings, view_board, view_experts, view_plugins, view_usage, view_artifacts, view_artifact } from "./src/panels.bun"
import { fire_due, add_schedule, delete_schedule, next_after } from "./src/schedule.bun"
import { add_memory, update_memory, delete_memory } from "./src/memory.bun"
import { ticket_new, ticket_by_id, ticket_move, ticket_claim, ticket_settle } from "./src/work.bun"
import { hatch } from "./src/experts.bun"

let PORT = int(getenv_or("PORT", "8801"))

// --------------------------------------------------------------- bootstrap

fn boot() {
    var st = state()
    if len(st.keys()) == 0 {
        reset(seed())
    }
}

// ------------------------------------------------------------------ assets

let TYPES = {
    "css": "text/css; charset=utf-8",
    "js": "text/javascript; charset=utf-8",
    "svg": "image/svg+xml",
    "png": "image/png",
    "woff2": "font/woff2",
    "ico": "image/x-icon",
    "json": "application/json; charset=utf-8"
}

fn asset(name) {
    let path = "assets/" + name
    if not file_exists(path) {
        return http_text(404, "not found")
    }
    let parts = name.split(".")
    let ext = parts[len(parts) - 1]
    var kind = TYPES[ext]
    if kind == null {
        kind = "application/octet-stream"
    }
    let body = read_file(path)
    return {
        "status": 200,
        "headers": { "content-type": kind, "cache-control": "public, max-age=60" },
        "body": body
    }
}

// ------------------------------------------------------------------ pages

fn ensure_thread(st, dot_id) {
    var latest = null
    var i = 0
    while i < len(st["threads"]) {
        let t = st["threads"][i]
        if t["dot"] == dot_id {
            if latest == null or t["at"] > latest["at"] {
                latest = t
            }
        }
        i += 1
    }
    if latest == null {
        latest = { "id": new_id("t"), "dot": dot_id, "title": "New thread", "at": now(), "messages": [] }
        st["threads"].push(latest)
        commit()
    }
    return latest
}

fn dot_page(st, id, focus, start_at, thread_id) {
    let dot = dot_by_id(st, id)
    if dot == null {
        return null
    }
    var thread = null
    if thread_id != "" {
        thread = thread_by_id(st, thread_id)
        if thread != null and thread["dot"] != id {
            thread = null
        }
    }
    if thread == null {
        thread = ensure_thread(st, id)
    }
    // Opening a bun's page is reading it: the unread count on the rail falls
    // to zero because the count means "not read yet".
    var i = 0
    var dirty = false
    while i < len(st["threads"]) {
        let t = st["threads"][i]
        if t["dot"] == id {
            var seen = t["seen"] ?? 0
            if seen != len(t["messages"]) {
                t["seen"] = len(t["messages"])
                dirty = true
            }
        }
        i += 1
    }
    if dirty {
        commit()
    }
    return view_dot(st, dot, thread, focus, start_at)
}

// ------------------------------------------------------------------ api

fn read_json(req) {
    if len(req["body"]) == 0 {
        return {}
    }
    try {
        return json_parse(req["body"])
    } catch err {
        return {}
    }
}

// GET /api/state — the whole workspace, as OpenDots serves it.
fn api_state() {
    return http_json(200, state())
}

// POST /api/tasks — start a task now, or attach a schedule to a goal.
fn api_new_task(req) {
    let st = state()
    let body = read_json(req)
    let dot_id = body["dot"] ?? ""
    let goal = str(body["goal"] ?? "").trim()
    if dot_id == "" or len(goal) == 0 {
        return http_json(400, { "ok": false, "error": "A task needs a bun and a goal." })
    }
    if dot_by_id(st, dot_id) == null {
        return http_json(404, { "ok": false, "error": "No such bun." })
    }
    if body["schedule"] != null {
        let cadence = body["schedule"]["cadence"] ?? "daily"
        let s = add_schedule(st, dot_id, goal, cadence, next_after(now(), cadence))
        return http_json(200, { "ok": true, "schedule": s })
    }
    let out = send_message(st, dot_id, "", goal)
    return http_json(200, { "ok": true, "task": out["run"]["id"], "thread": out["thread"]["id"], "status": out["run"]["status"] })
}

fn api_get_task(task_id) {
    let st = state()
    let run = run_by_id(st, task_id)
    if run == null {
        return http_json(404, { "ok": false, "error": "No such task." })
    }
    return http_json(200, { "ok": true, "task": run })
}

// POST /api/tasks/:id/actions — approve, refuse, or respond in the thread.
fn api_task_actions(req, task_id) {
    let st = state()
    let body = read_json(req)
    let action = str(body["action"] ?? "").lower()
    let run = run_by_id(st, task_id)
    if run == null {
        return http_json(404, { "ok": false, "error": "No such task." })
    }
    if action == "approve" or action == "refuse" {
        if run["status"] != "waiting" {
            return http_json(409, { "ok": false, "error": "This task is not waiting for a decision." })
        }
        let out = decide(st, task_id, action == "approve")
        return http_json(200, { "ok": true, "status": out["status"], "cursor": out["cursor"] })
    }
    if action == "respond" {
        let text = str(body["text"] ?? "").trim()
        if len(text) == 0 {
            return http_json(400, { "ok": false, "error": "A response needs a sentence." })
        }
        let thread = thread_by_id(st, run["thread"])
        if thread != null {
            thread["messages"].push({ "id": new_id("m"), "role": "user", "at": now(), "text": text })
            thread["at"] = now()
        }
        st["events"].push({ "at": now(), "dot": run["dot"], "text": "You replied on a task · " + clip(text, 56) })
        commit()
        return http_json(200, { "ok": true })
    }
    return http_json(400, { "ok": false, "error": "Actions are approve, refuse, or respond." })
}

// PUT /api/tasks/:id/schedule — make this task repeat.
fn api_task_schedule(req, task_id) {
    let st = state()
    let run = run_by_id(st, task_id)
    if run == null {
        return http_json(404, { "ok": false, "error": "No such task." })
    }
    let body = read_json(req)
    let cadence = body["cadence"] ?? "daily"
    let s = add_schedule(st, run["dot"], run["goal"], cadence, next_after(now(), cadence))
    return http_json(200, { "ok": true, "schedule": s })
}

fn api_memory_add(req) {
    let st = state()
    let body = read_json(req)
    let dot_id = body["dot"] ?? ""
    let text = str(body["text"] ?? "").trim()
    if dot_by_id(st, dot_id) == null {
        return http_json(404, { "ok": false, "error": "No such bun." })
    }
    if len(text) == 0 {
        return http_json(400, { "ok": false, "error": "A memory needs a sentence." })
    }
    let m = add_memory(st, dot_id, text, "manual")
    commit()
    return http_json(200, { "ok": true, "memory": m })
}

fn api_memory_update(req, mem_id) {
    let st = state()
    let body = read_json(req)
    let m = update_memory(st, mem_id, str(body["text"] ?? ""))
    if m == null {
        return http_json(404, { "ok": false, "error": "No such memory." })
    }
    commit()
    return http_json(200, { "ok": true, "memory": m })
}

fn api_memory_delete(mem_id) {
    let st = state()
    if not delete_memory(st, mem_id) {
        return http_json(404, { "ok": false, "error": "No such memory." })
    }
    commit()
    return http_json(200, { "ok": true })
}

// PATCH /api/settings — merge the given keys; the workspace name too.
fn api_settings(req) {
    let st = state()
    let body = read_json(req)
    let s = st["settings"]
    if body["name"] != null and len(str(body["name"]).trim()) > 0 {
        st["workspace"]["name"] = str(body["name"]).trim()
    }
    if body["tz_label"] != null and len(str(body["tz_label"]).trim()) > 0 {
        s["tz_label"] = str(body["tz_label"]).trim()
    }
    if body["notify_gates"] != null {
        s["notify_gates"] = body["notify_gates"] == true
    }
    if body["notify_digest"] != null {
        s["notify_digest"] = body["notify_digest"] == true
    }
    if body["rules"] != null {
        if s["rules"] == null {
            s["rules"] = { "auto_low": false, "always_ask_mail": true }
        }
        if body["rules"]["auto_low"] != null {
            s["rules"]["auto_low"] = body["rules"]["auto_low"] == true
        }
        if body["rules"]["always_ask_mail"] != null {
            s["rules"]["always_ask_mail"] = body["rules"]["always_ask_mail"] == true
        }
    }
    commit()
    return http_json(200, { "ok": true, "settings": s })
}

fn api_delete_schedule(sched_id) {
    let st = state()
    if not delete_schedule(st, sched_id) {
        return http_json(404, { "ok": false, "error": "No such schedule." })
    }
    return http_json(200, { "ok": true })
}


fn api_message(req) {
    let st = state()
    let body = read_json(req)
    let dot_id = body["dot"] ?? ""
    let text = body["text"] ?? ""
    if dot_id == "" or len(str(text).trim()) == 0 {
        return http_json(400, { "ok": false, "error": "A message needs a bun and a sentence." })
    }
    let dot = dot_by_id(st, dot_id)
    if dot == null {
        return http_json(404, { "ok": false, "error": "No such bun." })
    }
    let thread_id = body["thread"] ?? ""
    let out = send_message(st, dot_id, thread_id, str(text).trim())
    return http_json(200, { "ok": true, "thread": out["thread"]["id"], "run": out["run"]["id"], "status": out["run"]["status"] })
}

fn api_decide(req, run_id) {
    let st = state()
    let body = read_json(req)
    let approve = body["approve"] ?? false
    let run = run_by_id(st, run_id)
    if run == null {
        return http_json(404, { "ok": false, "error": "No such run." })
    }
    if run["status"] != "waiting" {
        return http_json(409, { "ok": false, "error": "This run is not waiting for a decision." })
    }
    let out = decide(st, run_id, approve)
    return http_json(200, { "ok": true, "status": out["status"], "cursor": out["cursor"], "run": out })
}

fn api_patch_page(req, page_id) {
    let st = state()
    let page = page_by_id(st, page_id)
    if page == null {
        return http_json(404, { "ok": false, "error": "No such page." })
    }
    let body = read_json(req)
    let rev = body["rev"] ?? -1
    if rev != page["rev"] {
        return http_json(409, { "ok": false, "error": "conflict", "rev": page["rev"] })
    }
    if body["body"] != null {
        page["body"] = body["body"]
    }
    if body["title"] != null and len(str(body["title"]).trim()) > 0 {
        page["title"] = str(body["title"]).trim()
    }
    page["rev"] += 1
    page["at"] = now()
    page["edited"] = "you"
    commit()
    return http_json(200, { "ok": true, "rev": page["rev"] })
}

fn api_new_page(req) {
    let st = state()
    let body = read_json(req)
    let space_id = body["space"] ?? ""
    if space_by_id(st, space_id) == null {
        return http_json(400, { "ok": false, "error": "A page needs a space." })
    }
    var page = {
        "id": "p_" + str(len(st["pages"]) + 1) + "_" + str(now() % 10000),
        "space": space_id,
        "parent": body["parent"],
        "title": body["title"] ?? "Untitled page",
        "by": "scout",
        "rev": 1,
        "at": now(),
        "body": "## Start here\n\nWrite the first line, or ask a coworker to."
    }
    st["pages"].push(page)
    commit()
    return http_json(200, { "ok": true, "id": page["id"], "space": space_id })
}

// ------------------------------------------------------- board and experts

// POST /api/tickets — a human opens a card.
fn api_ticket_new(req) {
    let st = state()
    let body = read_json(req)
    let title = str(body["title"] ?? "").trim()
    if len(title) == 0 {
        return http_json(400, { "ok": false, "error": "A ticket needs a title." })
    }
    let t = ticket_new(st, title, str(body["detail"] ?? "").trim(), "you")
    commit()
    return http_json(200, { "ok": true, "ticket": t })
}

// POST /api/tickets/:id/claim — a bun takes the card and starts a real task.
fn api_ticket_claim(req, ticket_id) {
    let st = state()
    let body = read_json(req)
    let dot_id = body["dot"] ?? ""
    if dot_by_id(st, dot_id) == null {
        return http_json(404, { "ok": false, "error": "No such bun." })
    }
    let out = ticket_claim(st, ticket_id, dot_id)
    if out == null {
        return http_json(404, { "ok": false, "error": "No such ticket, or it is already done." })
    }
    let started = send_message(st, dot_id, out["thread"]["id"], out["goal"])
    let run = started["run"]
    out["ticket"]["run"] = run["id"]
    run["ticket"] = out["ticket"]["id"]
    // A short task finished before the link existed; settle it now so the
    // card does not sit in doing forever.
    if run["status"] == "done" {
        ticket_settle(st, run["id"], true)
    }
    commit()
    return http_json(200, { "ok": true, "task": run["id"], "thread": out["thread"]["id"], "status": run["status"] })
}

// POST /api/tickets/:id/move — the human moves a card by hand.
fn api_ticket_move(req, ticket_id) {
    let st = state()
    let body = read_json(req)
    let t = ticket_move(st, ticket_id, str(body["status"] ?? ""))
    if t == null {
        return http_json(400, { "ok": false, "error": "No such ticket or status." })
    }
    commit()
    return http_json(200, { "ok": true, "ticket": t })
}

// POST /api/experts/:id/hatch — a new bun from the library.
fn api_hatch(expert_id) {
    let st = state()
    let dot = hatch(st, expert_id)
    if dot == null {
        return http_json(404, { "ok": false, "error": "No such expert." })
    }
    return http_json(200, { "ok": true, "dot": dot["id"] })
}

// POST /api/threads/:id/fork — copy the thread up to a message and continue
// the copy, leaving the original untouched.
fn api_thread_fork(req, thread_id) {
    let st = state()
    let source = thread_by_id(st, thread_id)
    if source == null {
        return http_json(404, { "ok": false, "error": "No such thread." })
    }
    let body = read_json(req)
    let upto = body["message"] ?? ""
    var kept = []
    var i = 0
    var found = false
    while i < len(source["messages"]) {
        kept.push(source["messages"][i])
        if upto != "" and source["messages"][i]["id"] == upto {
            found = true
            break
        }
        i += 1
    }
    if upto != "" and not found {
        return http_json(400, { "ok": false, "error": "That message is not in this thread." })
    }
    var copy = {
        "id": new_id("t"),
        "dot": source["dot"],
        "title": "Fork · " + clip(source["title"], 36),
        "at": now(),
        "messages": [],
        "fork_of": thread_id
    }
    var j = 0
    while j < len(kept) {
        let m = kept[j]
        copy["messages"].push({ "id": new_id("m"), "role": m["role"], "at": m["at"], "text": m["text"] })
        j += 1
    }
    st["threads"].push(copy)
    commit()
    return http_json(200, { "ok": true, "thread": copy["id"] })
}

// ------------------------------------------------------------------ router

fn route(req) {
    let path = req["path"]
    let method = req["method"]

    if method == "GET" and path == "/health" {
        return http_json(200, { "ok": true, "service": "buns" })
    }

    if method == "POST" and path == "/api/messages" {
        return api_message(req)
    }

    if method == "GET" and path == "/api/state" {
        return api_state()
    }

    if method == "POST" and (path == "/api/tasks" or path == "/api/schedules") {
        return api_new_task(req)
    }

    if path.starts_with("/api/tasks/") {
        let rest = path[11:]
        if rest.ends_with("/actions") {
            if method != "POST" {
                return http_json(405, { "ok": false, "error": "POST only." })
            }
            return api_task_actions(req, rest[0:len(rest) - 8])
        }
        if rest.ends_with("/schedule") {
            if method != "PUT" {
                return http_json(405, { "ok": false, "error": "PUT only." })
            }
            return api_task_schedule(req, rest[0:len(rest) - 9])
        }
        if method != "GET" {
            return http_json(405, { "ok": false, "error": "GET only." })
        }
        return api_get_task(rest)
    }

    if method == "POST" and path == "/api/memories" {
        return api_memory_add(req)
    }

    if path.starts_with("/api/memories/") {
        let mem_id = path[14:]
        if method == "PUT" {
            return api_memory_update(req, mem_id)
        }
        if method == "DELETE" {
            return api_memory_delete(mem_id)
        }
        return http_json(405, { "ok": false, "error": "PUT or DELETE only." })
    }

    if path.starts_with("/api/schedules/") {
        if method != "DELETE" {
            return http_json(405, { "ok": false, "error": "DELETE only." })
        }
        return api_delete_schedule(path[15:])
    }

    if path == "/api/settings" {
        if method != "PATCH" {
            return http_json(405, { "ok": false, "error": "PATCH only." })
        }
        return api_settings(req)
    }

    if method == "POST" and path == "/api/pages" {
        return api_new_page(req)
    }

    if path.starts_with("/api/tickets/") and path.ends_with("/claim") {
        if method != "POST" {
            return http_json(405, { "ok": false, "error": "POST only." })
        }
        return api_ticket_claim(req, path[13:len(path) - 6])
    }

    if path.starts_with("/api/tickets/") and path.ends_with("/move") {
        if method != "POST" {
            return http_json(405, { "ok": false, "error": "POST only." })
        }
        return api_ticket_move(req, path[13:len(path) - 5])
    }

    if method == "POST" and path == "/api/tickets" {
        return api_ticket_new(req)
    }

    if path.starts_with("/api/experts/") and path.ends_with("/hatch") {
        if method != "POST" {
            return http_json(405, { "ok": false, "error": "POST only." })
        }
        return api_hatch(path[13:len(path) - 6])
    }

    if path.starts_with("/api/threads/") and path.ends_with("/fork") {
        if method != "POST" {
            return http_json(405, { "ok": false, "error": "POST only." })
        }
        return api_thread_fork(req, path[13:len(path) - 5])
    }

    if path.starts_with("/api/runs/") and path.ends_with("/decide") {
        if method != "POST" {
            return http_json(405, { "ok": false, "error": "POST only." })
        }
        let id = path[10:len(path) - 7]
        return api_decide(req, id)
    }

    if path.starts_with("/api/pages/") {
        if method != "PATCH" and method != "POST" {
            return http_json(405, { "ok": false, "error": "PATCH only." })
        }
        let id = path[11:]
        return api_patch_page(req, id)
    }

    if path.starts_with("/assets/") {
        return asset(path[8:])
    }

    if method != "GET" {
        return http_text(405, "method not allowed")
    }

    let st = state()
    // A due schedule fires on read: the workspace has no background thread,
    // and a single person looking at a page is the clock that matters.
    fire_due(st)
    var parts = []
    var i = 0
    let raw = path.split("/")
    while i < len(raw) {
        if len(raw[i]) > 0 {
            parts.push(raw[i])
        }
        i += 1
    }

    if len(parts) == 0 {
        return http_html(200, view_today(st))
    }
    if parts[0] == "about" {
        return http_html(200, view_about(st))
    }
    if parts[0] == "tasks" {
        return http_html(200, view_tasks(st))
    }
    if parts[0] == "memories" {
        return http_html(200, view_memories(st))
    }
    if parts[0] == "settings" {
        return http_html(200, view_settings(st))
    }
    if parts[0] == "board" {
        return http_html(200, view_board(st))
    }
    if parts[0] == "experts" {
        return http_html(200, view_experts(st))
    }
    if parts[0] == "plugins" {
        return http_html(200, view_plugins(st))
    }
    if parts[0] == "usage" {
        return http_html(200, view_usage(st))
    }
    if parts[0] == "artifacts" and len(parts) == 1 {
        return http_html(200, view_artifacts(st))
    }
    if parts[0] == "artifacts" and len(parts) == 2 {
        let html = view_artifact(st, parts[1])
        if html == null {
            return http_text(404, "no such artifact")
        }
        return http_html(200, html)
    }
    if parts[0] == "spaces" and len(parts) == 1 {
        return http_html(200, view_spaces(st))
    }
    if parts[0] == "spaces" and len(parts) == 2 {
        let space = space_by_id(st, parts[1])
        if space == null {
            return http_text(404, "no such space")
        }
        return http_html(200, view_space(st, space))
    }
    if parts[0] == "spaces" and len(parts) == 4 and parts[2] == "p" {
        let space = space_by_id(st, parts[1])
        let page = page_by_id(st, parts[3])
        if space == null or page == null {
            return http_text(404, "no such page")
        }
        return http_html(200, view_page(st, space, page))
    }
    if parts[0] == "buns" and len(parts) == 2 {
        let focus = req["query"]["run"] ?? ""
        let start_at = int(req["query"]["from"] ?? "0")
        let thread_id = req["query"]["thread"] ?? ""
        let html = dot_page(st, parts[1], focus, start_at, thread_id)
        if html == null {
            return http_text(404, "no such bun")
        }
        return http_html(200, html)
    }
    // The old /dots/ paths keep working; every link this build emits is /buns/.
    if parts[0] == "dots" and len(parts) == 2 {
        let focus = req["query"]["run"] ?? ""
        let start_at = int(req["query"]["from"] ?? "0")
        let thread_id = req["query"]["thread"] ?? ""
        let html = dot_page(st, parts[1], focus, start_at, thread_id)
        if html == null {
            return http_text(404, "no such bun")
        }
        return http_html(200, html)
    }
    if parts[0] == "search" {
        let q = req["query"]["q"] ?? ""
        return http_html(200, view_search(st, url_decode(q)))
    }
    return http_text(404, "not found")
}

// ------------------------------------------------------------------ decode

fn url_decode(text) {
    var out = ""
    var i = 0
    let t = str(text)
    while i < len(t) {
        let ch = t[i]
        if ch == "+" {
            out += " "
        } else if ch == "%" and i + 2 < len(t) {
            let hex = t[i + 1:i + 3]
            out += str(char_from_hex(hex))
            i += 2
        } else {
            out += ch
        }
        i += 1
    }
    return out
}

fn char_from_hex(hex) {
    let digits = "0123456789abcdef"
    var value = 0
    var i = 0
    let h = str(hex).lower()
    while i < len(h) {
        let idx = digits.index_of(h[i])
        if idx < 0 {
            return ""
        }
        value = value * 16 + idx
        i += 1
    }
    if value < 128 {
        return str_from_byte(value)
    }
    return ""
}

fn str_from_byte(code) {
    return utf8_string([code])
}

// -------------------------------------------------------------------- main

fn handler(req) {
    try {
        let res = route(req)
        res["headers"] = merge_headers(res)
        return res
    } catch err {
        print("[buns] " + str(err))
        return http_text(500, "the server could not answer that")
    }
}

fn merge_headers(res) {
    var headers = { "x-content-type-options": "nosniff", "referrer-policy": "same-origin" }
    let given = res["headers"]
    if given != null {
        var keys = given.keys()
        var i = 0
        while i < len(keys) {
            headers[keys[i]] = given[keys[i]]
            i += 1
        }
    }
    return headers
}

boot()
print("[buns] listening on http://localhost:" + str(PORT))
let server = http_listen("0.0.0.0", PORT)
http_serve_forever(server, handler)
