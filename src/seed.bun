    // -------------------------------------------------------------- sheet
    st["sheet"] = {
        "id": "s_pipeline",
        "name": "Pipeline — Q4",
        "columns": ["Account", "Stage", "Entities", "Value", "Owner", "Next"],
        "rows": [
            ["Northwind", "Committed", "3", "€84,000", "Relay", "Signature"],
            ["Cascade", "Best case", "1", "€36,000", "Post", "Reference call"],
            ["Orlo", "Best case", "2", "€52,000", "Relay", "Security review"],
            ["Melrose", "Committed", "1", "€28,000", "Post", "Freight answer"],
            ["Halden", "Pipeline", "4", "€110,000", "Scout", "Discovery"],
            ["Bracken", "Pipeline", "1", "€19,000", "Relay", "No contact since Sept"]
        ]
    }

    // ----------------------------------------------------------- channels
    st["channels"] = [
        {
            "id": "ops",
            "name": "ops",
            "messages": [
                { "by": "relay", "at": t - 3600 * 6, "text": "Northwind signature moved to Thursday. Their CFO is out until then." },
                { "by": "ledger", "at": t - 3600 * 4, "text": "That pushes the quarter by a week. Weighted still holds if Cascade lands." },
                { "by": "forge", "at": t - 3600 * 3, "text": "Export fix is in review. Loader refuses partial files now." }
            ]
        }
    ]

    // ----------------------------------------------------------- calendar
    st["calendar"] = [
        { "id": "e1", "title": "Pipeline review", "at": t + 3600 * 3, "who": ["relay", "ledger"] },
        { "id": "e2", "title": "Reference call — Marcus", "at": t + 86400 * 2 + 3600 * 7, "who": ["post"] },
        { "id": "e3", "title": "Launch copy read-through", "at": t + 86400 * 4, "who": ["scout", "post"] }
    ]

    // ------------------------------------------------------------ threads
    st["threads"] = [
        {
            "id": "t_scout",
            "dot": "scout",
            "title": "Buyer brief for the October launch",
            "at": t - 3600 * 2,
            "messages": [
                {
                    "id": "m_a1",
                    "role": "user",
                    "at": t - 3600 * 2,
                    "text": "Brief me on the mid-market buyer before Thursday. I want the objection, not the persona."
                },
                {
                    "id": "m_a2",
                    "role": "dot",
                    "at": t - 3600 * 2 + 4,
                    "text": "Fourteen calls, three findings, one uncomfortable one. The brief is in the launch space — I kept the raw quotes out of the page and in the run log.",
                    "run": "r_seed_scout"
                }
            ]
        },
        {
            "id": "t_post",
            "dot": "post",
            "title": "Inbox — Tuesday",
            "at": t - 3600 * 5,
            "messages": [
                {
                    "id": "m_b1",
                    "role": "user",
                    "at": t - 3600 * 5,
                    "text": "Three pricing questions came in. Draft the replies, do not send them."
                },
                {
                    "id": "m_b2",
                    "role": "dot",
                    "at": t - 3600 * 5 + 3,
                    "text": "Three drafts are ready. Two are straightforward. The third needs a decision on per-entity pricing, so I have left it as a question rather than an answer.",
                    "run": "r_seed_post"
                }
            ]
        }
    ]

    // --------------------------------------------------------------- runs
    st["runs"] = [
        {
            "id": "r_seed_scout",
            "dot": "scout",
            "thread": "t_scout",
            "goal": "Brief me on the mid-market buyer before Thursday.",
            "at": t - 3600 * 2,
            "cursor": 4,
            "status": "done",
            "steps": [
                {
                    "id": "s1",
                    "tool": "web.search",
                    "label": "Searched for mid-market ERP buying behaviour",
                    "risk": 0,
                    "state": "done",
                    "ms": 1100,
                    "detail": "5 results, 3 kept",
                    "screen": {
                        "kind": "search",
                        "title": "Search",
                        "url": "search.buns/ops buying behaviour",
                        "hits": [
                            { "title": "Mid-market operations software: the 2026 buyer survey", "site": "fieldnotes.example", "note": "412 leads, integration time first" },
                            { "title": "Why ERP replacements fail — a postmortem collection", "site": "stackpost.example", "note": "31 write-ups, coded" },
                            { "title": "The spreadsheet is the competitor", "site": "fieldnotes.example", "note": "essay, 6 min" }
                        ]
                    }
                },
                {
                    "id": "s2",
                    "tool": "web.open",
                    "label": "Read the buyer survey and the postmortem collection",
                    "risk": 0,
                    "state": "done",
                    "ms": 1600,
                    "detail": "2 documents, 9 notes",
                    "screen": {
                        "kind": "reader",
                        "title": "The 2026 buyer survey",
                        "url": "fieldnotes.example/surveys/ops-2026",
                        "lines": [
                            "412 operations leads, 80–400 staff.",
                            "What stalls a rollout: integration time (61%), data quality (48%), internal ownership (39%), price (22%).",
                            "The survey's conclusion: buyers do not evaluate software, they evaluate the first month."
