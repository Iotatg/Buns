            "text": "Marcus takes calls Thursday after 15:00 or any time Friday morning.",
            "source": "auto",
            "at": t - 3600 * 9
        },
        {
            "id": "mem6",
            "dot": "post",
            "text": "Priya's freight-splitting answer is owed after the entity-C decision lands.",
            "source": "auto",
            "at": t - 3600 * 27
        }
    ]

    // --------------------------------------------------------- schedules
    st["schedules"] = [
        {
            "id": "sch1",
            "dot": "ledger",
            "goal": "Review the pipeline sheet and flag every row that moved.",
            "cadence": "weekdays",
            "next_at": t + 3600 * 20
        },
        {
            "id": "sch2",
            "dot": "post",
            "goal": "Triage the inbox and draft replies to anything unread.",
            "cadence": "daily",
            "next_at": t + 3600 * 14
        }
    ]

    // ---------------------------------------------------------- settings
    st["settings"] = {
        "tz_label": "IST",
        "compact": false,
        "notify_gates": true,
        "notify_digest": false,
        "integrations": {
            "slack": "Not connected",
            "gmail": "Not connected",
            "mcp": "Not connected"
        }
    }

    st["outbox"] = []
    st["events"] = [
        { "at": t - 3600 * 2, "dot": "scout", "text": "Finished · Brief me on the mid-market buyer before Thursday." },
        { "at": t - 3600 * 5, "dot": "post", "text": "Started · Draft replies to the three pricing questions." },
        { "at": t - 86400 * 2, "dot": "forge", "text": "Finished · Fix the export to fail closed on a partial write." }
    ]
    st["seq"] = 100
    return st
}
