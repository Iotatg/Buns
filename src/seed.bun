                "Priya"
            ])
        },
        {
            "id": "m4",
            "from": "Northwind AP",
            "address": "ap@northwind.example",
            "subject": "Invoice INV-2291",
            "at": t - 3600 * 51,
            "unread": false,
            "body": "Invoice INV-2291 is approved for payment on the 30th."
        }
